{
  "manifest_version": 3,
  "name": "Day Arc Focus & Enforcement Companion",
  "version": "1.1.0",
  "description": "Companion extension for Day Arc time management and URL enforcement tool.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Day Arc Focus Companion"
  },
  "icons": {
    "16": "icons/icon-48.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
